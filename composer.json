{
    "name": "slakbal/tenancy-foundation",
    "description": "Multi-tenancy foundation for Laravel and Filament: tenant/user/admin models, authorisation, panel plugins and defaults.",
    "keywords": ["laravel", "filament", "multi-tenancy"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.17",
        "spatie/laravel-permission": "^8.3",
        "stechstudio/filament-impersonate": "^5.6"
    },
    "require-dev": {
        "l3aro/filament-turnstile": "^1.1",
        "heyosseus/sloppy": "^1.8",
        "laramint/laravel-brain": "^2.7",
        "brianium/paratest": "<7.28",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "suggest": {
        "l3aro/filament-turnstile": "Adds a Turnstile captcha to the public contact form (TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY)"
    },
    "autoload": {
        "psr-4": {
            "Slakbal\\TenancyFoundation\\": "src/",
            "Slakbal\\TenancyFoundation\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Slakbal\\TenancyFoundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Slakbal\\TenancyFoundation\\TenancyFoundationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "pest --parallel",
            "pest --parallel --configuration=phpunit.domain.xml"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
